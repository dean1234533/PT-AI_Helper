rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User's own data — strictly scoped to owning UID, plus read access for the
    // linked trainer (if this user was invited by one) so they can monitor progress.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(userId)/data/profile).data.trainerId == request.auth.uid;
    }

    // Trainer-managed client records — reads/creates scoped to the owning trainer.
    // Updates stay open to `request.auth != null` (server functions patch these via
    // REST using only an API key, not a user auth token, so this must not be tightened
    // further without re-verifying those flows). Deletes are blocked; clients are
    // archived, not removed.
    match /clients/{doc} {
      allow read: if request.auth != null && request.auth.uid == resource.data.trainerId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.trainerId;
      allow update: if request.auth != null;
      allow delete: if false;
    }

    // Check-ins: server functions create/update unauthenticated via REST API.
    // Only authenticated users (trainer) can read. Nobody can delete.
    match /checkIns/{doc} {
      allow read: if request.auth != null;
      allow create: if true;
      allow update: if true;
      allow delete: if false;
    }
  }
}
