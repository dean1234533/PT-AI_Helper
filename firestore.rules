rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User's own data — strictly scoped to owning UID, plus read access for the
    // linked trainer (if this user was invited by one) so they can monitor progress.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(userId)/data/profile).data.trainerId == request.auth.uid;
    }

    // Trainer-managed client records — read/create/update scoped to the owning
    // trainer. Server functions (ScheduledCheckins, complete-invite, etc.)
    // authenticate as a service account and bypass these rules entirely, so
    // this doesn't need to stay open for them. Deletes are blocked; clients
    // are archived (see `archived` field), not removed.
    match /clients/{doc} {
      allow read, update: if request.auth != null && request.auth.uid == resource.data.trainerId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.trainerId;
      allow delete: if false;
    }

    // Check-ins: server functions create/update unauthenticated via REST API.
    // Only authenticated users (trainer) can read. Nobody can delete.
    match /checkIns/{doc} {
      allow read: if request.auth != null;
      allow create: if true;
      allow update: if true;
      allow delete: if false;
    }
  }
}
