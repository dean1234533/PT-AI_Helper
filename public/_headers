/plan
  X-Robots-Tag: noindex, nofollow

/checkin
  X-Robots-Tag: noindex, nofollow

/checkin/*
  X-Robots-Tag: noindex, nofollow

/profile
  X-Robots-Tag: noindex, nofollow

/clients
  X-Robots-Tag: noindex, nofollow

/challenges
  X-Robots-Tag: noindex, nofollow

/analysis
