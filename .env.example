# ── Firebase (create project at https://console.firebase.google.com) ──────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Admin bypass (your email — bypasses all plan limits) ─────────────────────
VITE_ADMIN_EMAIL=

# ── App URL (used for Stripe redirects) ──────────────────────────────────────
VITE_APP_URL=

# ── Cloudflare Pages Environment Variables (set in CF dashboard, NOT .env) ───

# Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# USDA FoodData Central — free key at https://fdc.nal.usda.gov/api-key-signup.html
USDA_API_KEY=
# Resend — free 3000 emails/month at https://resend.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=plans@yourdomain.com

# ── Check-in system (Firebase REST API — used by Cloudflare Functions) ────────
# These are the same values as the VITE_ ones above, just without the prefix
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
# ── Stripe — https://dashboard.stripe.com ─────────────────────────────────────
# Create a recurring price in Stripe dashboard, paste the price ID here

STRIPE_PRICE_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_RETURN_URL=
