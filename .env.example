# ── Firebase (create project at https://console.firebase.google.com) ──────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Web Push certificate — Firebase Console → Project Settings → Cloud Messaging → Web configuration
VITE_FIREBASE_VAPID_KEY=

# ── Admin bypass (your email — bypasses all plan limits) ─────────────────────
VITE_ADMIN_EMAIL=

# ── App URL (used for Stripe redirects) ──────────────────────────────────────
VITE_APP_URL=

# ── Cloudflare Pages Environment Variables (set in CF dashboard, NOT .env) ───

# Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# USDA FoodData Central — free key at https://fdc.nal.usda.gov/api-key-signup.html
USDA_API_KEY=
# Resend — free 3000 emails/month at https://resend.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=plans@yourdomain.com

# ── Check-in system (Firebase REST API — used by Cloudflare Functions) ────────
# These are the same values as the VITE_ ones above, just without the prefix
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=

# ── Push notifications (Firebase Cloud Messaging HTTP v1 API) ────────────────
# Full JSON key of a service account with Firebase Cloud Messaging send permission
FCM_SERVICE_ACCOUNT_JSON=

# ── External daily cron (Cloudflare Pages has no native Cron Trigger support) ─
# Shared secret checked against the X-Cron-Secret header on
# POST /api/ScheduledCheckins?runAll=true — point a free scheduler
# (e.g. cron-job.org) at that URL once a day with this header set.
CRON_SECRET=
# ── Stripe — https://dashboard.stripe.com ─────────────────────────────────────
# Create both recurring prices in Stripe and configure them on the app project.
STRIPE_PERSONAL_PRICE_ID=
STRIPE_PT_PRO_PRICE_ID=
STRIPE_PRICE_ID= # legacy PT Pro fallback
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_RETURN_URL=https://app.dbworkouts.co.uk/dashboard
APP_URL=https://app.dbworkouts.co.uk
